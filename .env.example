# ---------- Higgsfield ----------
# Tu clave de https://console.higgsfield.ai → API Keys. Solo se usa en el servidor.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# ---------- Supabase (opcional: login, historial en la nube y archivos permanentes) ----------
# Ejecuta supabase/edavi_install.sql en tu proyecto antes de usarlo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails (separados por coma) que pueden generar con la clave de Higgsfield del servidor.
ADMIN_EMAILS=

# 1 = cualquier usuario con sesión puede generar usando SU PROPIA clave de Higgsfield.
ALLOW_OWN_KEYS=

# ---------- Sin Supabase ----------
# Si publicas la app sin login, protege tus créditos con una contraseña.
STUDIO_PASSWORD=

# Modo demostración: simula la API sin gastar créditos (1 = activado).
HF_MOCK=
