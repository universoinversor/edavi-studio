# Credenciales de Higgsfield (https://console.higgsfield.ai → API Keys).
# Se usan SOLO en el servidor; nunca llegan al navegador.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Opcional pero MUY recomendado si publicas la app en internet con tus credenciales:
# pide esta contraseña antes de dejar generar (evita que desconocidos gasten tus créditos).
STUDIO_PASSWORD=

# Modo demostración: simula la API sin gastar créditos (1 = activado).
HF_MOCK=
